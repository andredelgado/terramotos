    "test:ui": "playwright test --ui"
  },
  "devDependencies": {
    "@fontsource/inter": "5.3.0",
    "@playwright/test": "1.64.1",
    "eslint": "^10.14.0",
    "wrangler": "4.160.0"
  }
}
